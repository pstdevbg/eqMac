# source 'https://github.com/AudioKit/Specs.git' # repo deleted; no pods use it
source 'https://github.com/CocoaPods/Specs.git'

# Uncomment the next line to define a global platform for your project
platform :osx, '10.12'
workspace 'eqMac.xcworkspace'
use_frameworks!

post_install do |installer|
  # Sentry 7.1.3 relies on headers being included transitively, which the newer macOS SDK / libc++ no longer does
  {
    'Pods/Sentry/Sources/SentryCrash/Recording/Monitors/SentryCrashMonitor_CPPException.cpp' => '#include <exception>',
    'Pods/Sentry/Sources/SentryCrash/Recording/Tools/SentryCrashMachineContext.c' => '#include <sys/_types/_ucontext64.h>'
  }.each do |path, include|
    src = File.read(path)
    next if src.include?(include)
    File.chmod(0644, path)
    File.write(path, include + "\n" + src)
  end

  # Zip's Swift module re-exports its internal Minizip module, which newer Xcode must also resolve from the app target
  installer.aggregate_targets.each do |aggregate|
    aggregate.xcconfigs.each do |config_name, xcconfig|
      xcconfig.attributes['SWIFT_INCLUDE_PATHS'] = '$(inherited) "${PODS_ROOT}/Zip/Zip/minizip/module"'
      xcconfig.save_as(aggregate.xcconfig_path(config_name))
    end
  end

  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['MACOSX_DEPLOYMENT_TARGET'] = '10.12'
    end
  end
end

# ignore all warnings from all pods
inhibit_all_warnings!

def shared_pods
  pod 'STPrivilegedTask', :git => 'https://github.com/sveinbjornt/STPrivilegedTask.git', :commit => 'fdca677c77adb166a2be4c5ea9c7580a738c49c9'
end

project 'app/eqMac.xcodeproj'

target 'eqMac' do
  project 'app/eqMac.xcodeproj'

  pod 'SwiftHTTP', '~> 3.0'
  pod 'AMCoreAudio', :path => 'vendor/AMCoreAudio' # bitgapp fork deleted; pinned commit b312d15 vendored from rnine/AMCoreAudio
  pod 'WebViewJavascriptBridge', '~> 6.0'
#  pod 'ReachabilitySwift'
  pod 'ReSwift', '~> 6.1'
  pod 'SwiftLint'
  pod 'Sparkle', '~> 1.24'
  pod 'Sentry', '~> 7.1.3'
  pod 'EmitterKit', '~> 5.2.2'
  pod 'SwiftyJSON', '~> 4.2'
  pod 'SwiftyUserDefaults', '4.0'
  pod 'KeychainSwift', '~> 13.0'
  pod 'Zip', :git => 'https://github.com/bitgapp/Zip.git'
  shared_pods

end


